{
    "name": "jankx/payment-system",
    "description": "Jankx Payment System with Omnipay integration",
    "type": "wordpress-extension",
    "require": {
        "league/omnipay": "^3.0",
        "omnipay/paypal": "^3.0",
        "omnipay/stripe": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Jankx\\Extensions\\PaymentSystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jankx\\Extensions\\PaymentSystem\\Tests\\": "tests/"
        }
    }
}
